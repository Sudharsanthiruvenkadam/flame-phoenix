.workspace-page {
  min-height: 100vh;
  background: #fffaf6;
  color: #29211d;
}

.workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 18px 6%;
  background: #fff;
  border-bottom: 1px solid #f0e5dc;
}

.workspace-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #a84412;
  text-decoration: none;
  font-weight: 650;
}

.workspace-brand {
  font-weight: 800;
}

.workspace-content {
  width: min(1000px, 90%);
  margin: 0 auto;
  padding: 40px 0 60px;
}

.workspace-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #bd4d15;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
}

.workspace-heading h1 {
  margin: 12px 0 8px;
  font-size: clamp(30px, 5vw, 42px);
}

.workspace-heading p,
.project-item p {
  color: #766b64;
  line-height: 1.6;
}

.project-form-card,
.project-item,
.project-empty {
  padding: 24px;
  border: 1px solid #f0e1d6;
  border-radius: 16px;
  background: #fff;
}

.project-form-card {
  margin-top: 28px;
}

.project-form-card h2 {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 24px;
}

.project-form {
  display: grid;
  gap: 10px;
}

.project-form label {
  margin-top: 8px;
  font-size: 14px;
  font-weight: 700;
}

.project-form input,
.project-form select,
.project-form textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 12px 13px;
  border: 1px solid #e7d8cd;
  border-radius: 9px;
  background: #fff;
  color: #29211d;
  font: inherit;
}

.project-form input:focus,
.project-form select:focus,
.project-form textarea:focus {
  outline: 2px solid #f5c5a7;
  border-color: #c45116;
}

.project-form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.project-form-row > div {
  display: grid;
  gap: 10px;
}

.project-form button {
  margin-top: 12px;
  padding: 13px 18px;
  border: 0;
  border-radius: 10px;
  background: #c45116;
  color: #fff;
  font: inherit;
  font-weight: 750;
  cursor: pointer;
}

.project-form button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.workspace-error {
  color: #b42318;
}

.workspace-success {
  color: #187744;
}

.project-list-section {
  margin-top: 42px;
}

.project-list-section > h2 {
  margin-bottom: 18px;
}

.project-list {
  display: grid;
  gap: 14px;
}

.project-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
}

.project-item h3 {
  margin: 0 0 8px;
}

.project-item p {
  margin: 5px 0;
}

.project-description {
  max-width: 650px;
  overflow-wrap: anywhere;
}

.project-status {
  flex-shrink: 0;
  padding: 7px 10px;
  border-radius: 20px;
  background: #fff0e5;
  color: #a5400e;
  font-size: 11px;
  font-weight: 800;
}

.project-empty {
  display: grid;
  justify-items: center;
  gap: 8px;
  color: #a84412;
  text-align: center;
}

.project-empty p {
  margin: 0;
  color: #29211d;
  font-weight: 700;
}

.project-empty span {
  color: #766b64;
}

@media (max-width: 640px) {
  .project-form-row {
    grid-template-columns: 1fr;
  }

  .project-item {
    flex-direction: column;
  }
}
